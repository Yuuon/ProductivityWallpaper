<UserControl x:Class="ProductivityWallpaper.Views.CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ProductivityWallpaper.ViewModels"
             xmlns:models="clr-namespace:ProductivityWallpaper.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CreatorViewModel}">

    <UserControl.Resources>
        <!-- Scheme Item Template for Submenu -->
        <DataTemplate x:Key="SchemeItemTemplate" DataType="{x:Type models:SchemeModel}">
            <Button Command="{Binding DataContext.SelectSchemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    HorizontalContentAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SchemeSelectedBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Button>
        </DataTemplate>

        <!-- New Scheme Button Style -->
        <Style x:Key="NewSchemeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Feature Expander Toggle Button Style -->
        <Style x:Key="FeatureExpanderButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BackgroundBlockBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundMainBrush}"
          MouseDown="CreatorView_MouseDown">
        
        <!-- Welcome Page -->
        <Grid Visibility="{Binding IsWelcomePage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                <TextBlock Text="{DynamicResource Creator_WelcomeTitle}"
                           Style="{StaticResource HeaderTextStyle}"
                           TextAlignment="Center"
                           Margin="0,0,0,32"/>
                
                <Border Background="{StaticResource BackgroundBlockBrush}"
                        BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Height="40"
                        Margin="0,0,0,24">
                    <Grid>
                        <TextBlock Text="{DynamicResource Creator_ThemeNamePlaceholder}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding NewThemeName, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBox Text="{Binding NewThemeName, UpdateSourceTrigger=PropertyChanged}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  CaretBrush="{StaticResource TextPrimaryBrush}"
                                  FontSize="14"
                                  Padding="16,0"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  TextAlignment="Center"/>
                    </Grid>
                </Border>
                
                <Button Content="{DynamicResource Creator_CreateTheme}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartCreatingCommand}"
                        Width="200"
                        Height="44"/>
            </StackPanel>
        </Grid>
        
        <!-- Creating Page -->
        <Grid Visibility="{Binding IsCreatingPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
            <Grid Grid.Column="0" Background="{StaticResource BackgroundBlockBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header: Back Button (left) + Save Button (right) -->
                <Grid Grid.Row="0" Margin="16,16,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Back Button (left side) -->
                    <Button Grid.Column="0"
                            Command="{Binding BackToWelcomeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 4L4 12L12 20 M6 12H20"
                                  Stroke="{StaticResource IconBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                            <TextBlock Text="{DynamicResource Creator_Back}"
                                       Foreground="{StaticResource IconBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Save Button (right side) -->
                    <Button Grid.Column="2"
                            Command="{Binding SaveThemeCommand}"
                            IsEnabled="{Binding IsDirty}"
                            ToolTip="Save theme changes">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M17 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V7l-4-4z M7 3v5h8V3 M17 21v-8H7v8"
                              StrokeThickness="2"
                              Width="20" Height="20"
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource IconBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </Grid>
                
                <!-- Scrollable Navigation -->
                <ScrollViewer Grid.Row="1" 
                               VerticalScrollBarVisibility="Auto"
                               Padding="0,0,12,0">
                    <StackPanel Margin="16,8,4,16">
                        
                        <!-- Theme Name in sidebar -->
                        <TextBlock Text="{Binding CurrentThemeName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0,0,12"
                                   ToolTip="{Binding CurrentThemeName}"/>
                        
                        <!-- ===== Theme Preview (Simple Button) ===== -->
                        <Button Command="{Binding SelectFeatureCommand}"
                                CommandParameter="ThemePreview">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FeatureButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemePreviewActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{DynamicResource Creator_Feature_ThemePreview}"
                                       VerticalAlignment="Center"/>
                        </Button>
                        
                        <!-- ===== Desktop Background (Expandable) ===== -->
                        <StackPanel Margin="0,8,0,0">
                            <ToggleButton IsChecked="{Binding IsDesktopBackgroundExpanded, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource FeatureExpanderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDesktopBackgroundHeaderHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Creator_Feature_DesktopBackground}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DesktopBackgroundSchemes.Count, StringFormat='({0})'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DesktopBackgroundSchemes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <Path Grid.Column="1"
                                          Data="M6 9L12 15L18 9"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDesktopBackgroundExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </ToggleButton>
                            
                            <Border Visibility="{Binding IsDesktopBackgroundExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Margin="8,4,0,0">
                                    <ItemsControl ItemsSource="{Binding DesktopBackgroundSchemes}"
                                                  ItemTemplate="{StaticResource SchemeItemTemplate}"/>
                                    <Button Content="+ 新建方案"
                                            Command="{Binding CreateNewSchemeCommand}"
                                            CommandParameter="{x:Static models:FeatureType.DesktopBackground}"
                                            Style="{StaticResource NewSchemeButtonStyle}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Height="32"
                                            Padding="12,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- ===== Mouse Click (Expandable) ===== -->
                        <StackPanel Margin="0,8,0,0">
                            <ToggleButton IsChecked="{Binding IsMouseClickExpanded, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource FeatureExpanderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseClickHeaderHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Creator_Feature_MouseClick}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MouseClickSchemes.Count, StringFormat='({0})'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding MouseClickSchemes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <Path Grid.Column="1"
                                          Data="M6 9L12 15L18 9"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseClickExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </ToggleButton>
                            
                            <Border Visibility="{Binding IsMouseClickExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Margin="8,4,0,0">
                                    <ItemsControl ItemsSource="{Binding MouseClickSchemes}"
                                                  ItemTemplate="{StaticResource SchemeItemTemplate}"/>
                                    <Button Content="+ 新建方案"
                                            Command="{Binding CreateNewSchemeCommand}"
                                            CommandParameter="{x:Static models:FeatureType.MouseClick}"
                                            Style="{StaticResource NewSchemeButtonStyle}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Height="32"
                                            Padding="12,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- ===== Shutdown (Expandable) ===== -->
                        <StackPanel Margin="0,8,0,0">
                            <ToggleButton IsChecked="{Binding IsShutdownExpanded, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource FeatureExpanderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShutdownHeaderHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Creator_Feature_Shutdown}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ShutdownSchemes.Count, StringFormat='({0})'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShutdownSchemes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <Path Grid.Column="1"
                                          Data="M6 9L12 15L18 9"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShutdownExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </ToggleButton>
                            
                            <Border Visibility="{Binding IsShutdownExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Margin="8,4,0,0">
                                    <ItemsControl ItemsSource="{Binding ShutdownSchemes}"
                                                  ItemTemplate="{StaticResource SchemeItemTemplate}"/>
                                    <Button Content="+ 新建方案"
                                            Command="{Binding CreateNewSchemeCommand}"
                                            CommandParameter="{x:Static models:FeatureType.Shutdown}"
                                            Style="{StaticResource NewSchemeButtonStyle}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Height="32"
                                            Padding="12,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- ===== Boot/Restart (Expandable) ===== -->
                        <StackPanel Margin="0,8,0,0">
                            <ToggleButton IsChecked="{Binding IsBootRestartExpanded, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource FeatureExpanderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBootRestartHeaderHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Creator_Feature_BootRestart}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BootRestartSchemes.Count, StringFormat='({0})'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding BootRestartSchemes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <Path Grid.Column="1"
                                          Data="M6 9L12 15L18 9"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBootRestartExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </ToggleButton>
                            
                            <Border Visibility="{Binding IsBootRestartExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Margin="8,4,0,0">
                                    <ItemsControl ItemsSource="{Binding BootRestartSchemes}"
                                                  ItemTemplate="{StaticResource SchemeItemTemplate}"/>
                                    <Button Content="+ 新建方案"
                                            Command="{Binding CreateNewSchemeCommand}"
                                            CommandParameter="{x:Static models:FeatureType.BootRestart}"
                                            Style="{StaticResource NewSchemeButtonStyle}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Height="32"
                                            Padding="12,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- ===== Screen Wake (Expandable) ===== -->
                        <StackPanel Margin="0,8,0,0">
                            <ToggleButton IsChecked="{Binding IsScreenWakeExpanded, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource FeatureExpanderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScreenWakeHeaderHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Creator_Feature_ScreenWake}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ScreenWakeSchemes.Count, StringFormat='({0})'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ScreenWakeSchemes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <Path Grid.Column="1"
                                          Data="M6 9L12 15L18 9"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScreenWakeExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </ToggleButton>
                            
                            <Border Visibility="{Binding IsScreenWakeExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Margin="8,4,0,0">
                                    <ItemsControl ItemsSource="{Binding ScreenWakeSchemes}"
                                                  ItemTemplate="{StaticResource SchemeItemTemplate}"/>
                                    <Button Content="+ 新建方案"
                                            Command="{Binding CreateNewSchemeCommand}"
                                            CommandParameter="{x:Static models:FeatureType.ScreenWake}"
                                            Style="{StaticResource NewSchemeButtonStyle}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Height="32"
                                            Padding="12,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- ===== Open App (Simple Button) ===== -->
                        <Button Command="{Binding SelectFeatureCommand}"
                                CommandParameter="OpenApp"
                                Margin="0,8,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FeatureButtonStyle}">
