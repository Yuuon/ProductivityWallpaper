<UserControl x:Class="ProductivityWallpaper.Views.MouseClickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ProductivityWallpaper.ViewModels"
             xmlns:models="clr-namespace:ProductivityWallpaper.Models"
             xmlns:converters="clr-namespace:ProductivityWallpaper.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MouseClickViewModel}"
             Background="{StaticResource BackgroundMainBrush}">

    <UserControl.Resources>
        <!-- Converters (must be defined before DataTemplates that reference them) -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
        <converters:InverseStringEmptyToVisibilityConverter x:Key="InverseStringEmptyToVisibilityConverter"/>
        <converters:BooleanToCursorConverter x:Key="BooleanToCursorConverter"/>
        <converters:DisplayModeToStretchConverter x:Key="DisplayModeToStretchConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <converters:PercentageToPixelConverter x:Key="PercentageToPixelConverter"/>
        <converters:PercentageToPixelMultiConverter x:Key="PercentageToPixelMultiConverter"/>
        <converters:MediaTypeIsVideoConverter x:Key="MediaTypeIsVideoConverter"/>

        <!-- Region Item Template -->
        <DataTemplate x:Key="RegionItemTemplate" DataType="{x:Type models:ClickRegionModel}">
            <Grid ClipToBounds="False">
                <Grid.Width>
                    <MultiBinding Converter="{StaticResource PercentageToPixelMultiConverter}">
                        <Binding Path="Width"/>
                        <Binding Path="ActualWidth" ElementName="RegionCanvas"/>
                    </MultiBinding>
                </Grid.Width>
                <Grid.Height>
                    <MultiBinding Converter="{StaticResource PercentageToPixelMultiConverter}">
                        <Binding Path="Height"/>
                        <Binding Path="ActualHeight" ElementName="RegionCanvas"/>
                    </MultiBinding>
                </Grid.Height>
                <Rectangle x:Name="RegionRect"
                           Fill="#3000A8FF"
                           Stroke="#8000A8FF"
                           StrokeThickness="2"
                           StrokeDashArray="4 2"
                           RadiusX="4"
                           RadiusY="4">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Fill" Value="#5000A8FF"/>
                                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="StrokeThickness" Value="2"/>
                                    <Setter Property="StrokeDashArray" Value="1 0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" 
                                                               BlurRadius="10" 
                                                               Color="{StaticResource AccentColor}" 
                                                               Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                
                <!-- Region Name Label -->
                <TextBlock Text="{Binding Name}"
                           Foreground="White"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- Delete Button (top-right corner inside the region) -->
                <Button x:Name="DeleteButton"
                        Command="{Binding DataContext.DeleteRegionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        Background="{StaticResource DangerBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="ButtonBg" Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="1.5"/>
                                <Path Data="M6 6L14 14 M14 6L6 14"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBg" Property="Fill" Value="#FF3333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Media Item Template (for Available Wallpapers panel — thumbnail only) -->
        <DataTemplate x:Key="MediaItemTemplate" DataType="{x:Type models:MediaItemModel}">
            <Border Background="{StaticResource BackgroundBlockBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,3"
                    ClipToBounds="True"
                    Cursor="Hand"
                    Height="72">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                   Command="{Binding DataContext.SetBackgroundMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"/>
                </Border.InputBindings>
                
                <Grid>
                    <!-- Image Thumbnail (for image types) -->
                    <Image Source="{Binding ThumbnailPath}"
                           Stretch="UniformToFill"
                           Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}, ConverterParameter=Invert}"/>
                    
                    <!-- Video Thumbnail (animated GIF via MediaElement) -->
                    <MediaElement Source="{Binding ThumbnailPath}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="UniformToFill"
                                  IsMuted="True"
                                  MediaOpened="OnThumbnailMediaOpened"
                                  MediaEnded="OnThumbnailMediaEnded"
                                  Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}}"/>
                    
                    <!-- Fallback icon when no thumbnail -->
                    <Border Background="{StaticResource BackgroundMainBrush}"
                            Visibility="{Binding ThumbnailPath, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                        <Path Data="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
                              Fill="{StaticResource IconBrush}"
                              Width="24" Height="24"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- File name overlay at bottom -->
                    <Border Background="#99000000"
                            VerticalAlignment="Bottom"
                            Padding="6,2">
                        <TextBlock Text="{Binding FileName}"
                                   Foreground="White"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Region Visual Item DataTemplate — same style as MediaConfigurationView -->
        <DataTemplate x:Key="RegionVisualItemTemplate" DataType="{x:Type models:MediaItemModel}">
            <Grid MinHeight="80">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136"/>       <!-- Thumbnail (120+16 margin) -->
                    <ColumnDefinition Width="*"/>         <!-- File info -->
                    <ColumnDefinition Width="Auto"/>      <!-- Controls -->
                </Grid.ColumnDefinitions>
                
                <!-- Thumbnail Container with preview button overlay -->
                <Border Grid.Column="0" Width="120" Height="68" CornerRadius="6" ClipToBounds="True"
                        Background="#FF121225" Margin="0,0,16,0">
                    <Grid>
                        <!-- Image Thumbnail -->
                        <Image Source="{Binding ThumbnailPath}"
                               Stretch="UniformToFill"
                               Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}, ConverterParameter=Invert}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value="">
                                            <Setter Property="Source" Value="{StaticResource DefaultThumbImage}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        
                        <!-- Video Thumbnail (animated GIF or static fallback) -->
                        <Grid Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}}">
                            <!-- Animated GIF thumbnail via MediaElement -->
                            <MediaElement Source="{Binding ThumbnailPath}"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="UniformToFill"
                                          IsMuted="True"
                                          MediaOpened="OnThumbnailMediaOpened"
                                          MediaEnded="OnThumbnailMediaEnded"
                                          Visibility="{Binding ThumbnailPath, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <!-- Fallback when no thumbnail -->
                            <Image Source="{StaticResource DefaultThumbImage}" 
                                   Stretch="Uniform"
                                   Visibility="{Binding ThumbnailPath, Converter={StaticResource InverseStringEmptyToVisibilityConverter}}"/>
                        </Grid>
                        
                        <!-- Preview Button Overlay -->
                        <Button Command="{Binding DataContext.PreviewMediaCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,4,4"
                                Width="28" Height="28"
                                Cursor="Hand"
                                ToolTip="Preview">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#CC000000" CornerRadius="14"
                                                        Width="28" Height="28">
                                                    <Path Data="M8 5V19L19 12L8 5Z"
                                                          Fill="White"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="2,0,0,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- File Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding FileName}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13"
                              TextTrimming="CharacterEllipsis"
                              MaxWidth="200"
                              HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Format}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11"/>
                        <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11"/>
                        <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                  Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}}"/>
                        <TextBlock Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11"
                                  Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}}"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Controls (Mute for video, Remove) -->
                <StackPanel Grid.Column="2"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    
                    <!-- Mute Toggle Button — VIDEO ONLY -->
                    <Button Command="{Binding DataContext.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding Type, Converter={StaticResource MediaTypeIsVideoConverter}}"
                            ToolTip="Toggle Mute"
                            Cursor="Hand"
                            Width="40" Height="40">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"
                                                    CornerRadius="20"
                                                    Width="40" Height="40">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Path Data="M11 5L6 9H2V15H6L11 19V5ZM16 12C16 10.5 15.2 9.2 14 8.4V15.5C15.2 14.8 16 13.5 16 12ZM19 12C19 13.4 18.6 14.7 17.9 15.9L19.3 17.3C20.3 15.7 20.8 13.9 20.8 12C20.8 8.1 18.2 4.8 14.7 3.9V5.7C17.1 6.5 19 9 19 12Z"
                                  Fill="{StaticResource IconBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Path Data="M3 9V15H7L12 20V4L7 9H3ZM16 12C16 13.66 15.17 15.13 13.93 16.02L15.35 17.44C17.22 16.05 18.5 13.77 18.5 11.99C18.5 10.21 17.22 7.94 15.35 6.55L13.93 7.97C15.17 8.85 16 10.33 16 12Z"
                                  Fill="{StaticResource AccentBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsMuted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    
                    <!-- Remove Button -->
                    <Button Command="{Binding DataContext.RemoveRegionVisualCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                            ToolTip="Remove"
                            Cursor="Hand"
                            Width="40" Height="40">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"
                                                    CornerRadius="20"
                                                    Width="40" Height="40">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M18 6L6 18M6 6L18 18"
                              Stroke="{StaticResource IconBrush}"
                              StrokeThickness="2"
                              Width="16" Height="16"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Region Audio Item DataTemplate — same style as MediaConfigurationView AudioItemTemplate -->
        <DataTemplate x:Key="RegionAudioItemTemplate" DataType="{x:Type models:MediaItemModel}">
            <Grid MinHeight="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>      <!-- Number -->
                    <ColumnDefinition Width="80"/>        <!-- Music Icon -->
                    <ColumnDefinition Width="*"/>         <!-- File info -->
                    <ColumnDefinition Width="Auto"/>      <!-- Controls -->
                </Grid.ColumnDefinitions>
                
                <!-- Number -->
                <TextBlock Grid.Column="0"
                          Text="{Binding OrderIndex, StringFormat='#{0}'}"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12"
                          Width="32"
                          VerticalAlignment="Center"/>
                
                <!-- Music Icon with Preview button overlay -->
                <Border Grid.Column="1" Width="64" Height="48" CornerRadius="6" ClipToBounds="True"
                        Background="#FF121225" Margin="0,0,16,0">
                    <Grid>
                        <!-- Music Note Icon -->
                        <Path Data="M12 3V13.55C11.41 13.21 10.73 13 10 13C8.34 13 7 14.34 7 16C7 17.66 8.34 19 10 19C11.66 19 13 17.66 13 16V5H18V3H12Z"
                              Fill="{StaticResource IconBrush}"
                              Width="24" Height="24"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        
                        <!-- Preview Button Overlay -->
                        <Button Command="{Binding DataContext.PreviewMediaCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,4,4"
                                Width="24" Height="24"
                                Cursor="Hand"
                                ToolTip="Preview">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#CC000000" CornerRadius="12"
                                                        Width="24" Height="24">
                                                    <Path Data="M8 5V19L19 12L8 5Z"
                                                          Fill="White"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="1,0,0,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- File Info -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding FileName}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13"
                              TextTrimming="CharacterEllipsis"
                              MaxWidth="200"
                              HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Format}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11"/>
                        <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Controls (Mute + Remove) -->
                <StackPanel Grid.Column="3"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    
                    <!-- Mute Toggle Button -->
                    <Button Command="{Binding DataContext.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"
                            ToolTip="Toggle Mute"
                            Cursor="Hand"
                            Width="40" Height="40">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"
                                                    CornerRadius="20"
                                                    Width="40" Height="40">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Path Data="M11 5L6 9H2V15H6L11 19V5ZM16 12C16 10.5 15.2 9.2 14 8.4V15.5C15.2 14.8 16 13.5 16 12ZM19 12C19 13.4 18.6 14.7 17.9 15.9L19.3 17.3C20.3 15.7 20.8 13.9 20.8 12C20.8 8.1 18.2 4.8 14.7 3.9V5.7C17.1 6.5 19 9 19 12Z"
                                  Fill="{StaticResource IconBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Path Data="M3 9V15H7L12 20V4L7 9H3ZM16 12C16 13.66 15.17 15.13 13.93 16.02L15.35 17.44C17.22 16.05 18.5 13.77 18.5 11.99C18.5 10.21 17.22 7.94 15.35 6.55L13.93 7.97C15.17 8.85 16 10.33 16 12Z"
                                  Fill="{StaticResource AccentBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsMuted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    
                    <!-- Remove Button -->
                    <Button Command="{Binding DataContext.RemoveRegionAudioCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"
                            ToolTip="Remove"
                            Cursor="Hand"
                            Width="40" Height="40">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"
                                                    CornerRadius="20"
                                                    Width="40" Height="40">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M18 6L6 18M6 6L18 18"
                              Stroke="{StaticResource IconBrush}"
                              StrokeThickness="2"
                              Width="16" Height="16"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ListView Styles for region resource lists -->
        <Style x:Key="RegionMediaListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        
        <Style x:Key="RegionMediaListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- ComboBox style for audio PlaybackMode dropdown -->
        <Style x:Key="RegionAudioPlaybackComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBlockBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4,24,4">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Path x:Name="Arrow"
                                  Data="M0,0 L4,4 L8,0"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource BackgroundBlockBrush}"
                                            BorderBrush="{StaticResource BorderLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,1,0,0"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="2">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundSelectedBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Section 1: Editable Title Bar -->
        <Grid Grid.Row="0" Margin="32,24,42,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Scheme Name Display -->
                <TextBlock Text="{Binding SchemeName, FallbackValue='Mouse Click Scheme'}"
                           Style="{StaticResource SubHeaderTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Visibility="{Binding IsEditingName, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                
                 <TextBox Text="{Binding SchemeName, UpdateSourceTrigger=PropertyChanged}"
                          Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         VerticalAlignment="Center"
                         MinWidth="200"
                         MaxWidth="400"
                         Visibility="{Binding IsEditingName, Converter={StaticResource BooleanToVisibilityConverter}}"
                         LostFocus="OnSchemeNameLostFocus"
                         KeyDown="OnSchemeNameKeyDown"/>
                
                <Button Command="{Binding ToggleEditNameCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Path Data="M525 148.414H531M528 137.414C528.265 137.149 528.625 137 529 137C529.186 137 529.37 137.037 529.541 137.108C529.713 137.179 529.869 137.283 530 137.414C530.131 137.546 530.235 137.701 530.307 137.873C530.378 138.045 530.414 138.228 530.414 138.414C530.414 138.6 530.378 138.784 530.307 138.955C530.235 139.127 530.131 139.283 530 139.414L521.667 147.748L519 148.414L519.667 145.748L528 137.414Z"
                          Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.6"
                          Width="16" Height="16"
                          Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Section 2: Page Header -->
        <TextBlock Grid.Row="1"
                   Text="Mouse Click"
                   Style="{StaticResource SubHeaderTextStyle}"
                   Margin="32,16,42,24"/>

        <!-- Section 3: Main Content (Two columns: Region Editor + Available Media) -->
        <Grid Grid.Row="2" Margin="32,0,42,24" MinHeight="480">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Region Editor -->
            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundBlockBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Bar -->
                    <Grid Grid.Row="0" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Set Click Regions"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            
                            <TextBlock Text="{Binding ScreenResolutionText, StringFormat=' ({0})'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Add Button -->
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsAddingMode, Mode=TwoWay}"
                                      Width="32"
                                      Height="32"
                                      Background="{StaticResource BackgroundMainBrush}"
                                      BorderBrush="{StaticResource BorderLineBrush}"
                                      BorderThickness="1"
                                      Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <Path x:Name="PlusIcon"
                                                           Data="M12 5v14M5 12h14"
                                                           Stroke="{StaticResource IconBrush}"
                                                           StrokeThickness="2"
                                                           Width="16"
                                                           Height="16"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <!-- Canvas Container -->
                    <Border Grid.Row="1"
                            Background="#333333"
                            CornerRadius="8"
                            Margin="16,0,16,16"
                            SizeChanged="OnCanvasContainerSizeChanged">
                        <Viewbox Stretch="Uniform" Margin="16">
                            <Grid x:Name="CanvasContainer"
                                  Width="1920"
                                  Height="1080">
                                <!-- Background Media: Image -->
                                <Image x:Name="BackgroundImage"
                                       Source="{Binding BackgroundMedia.FilePath}"
                                       Stretch="{Binding BackgroundMedia.DisplayMode, Converter={StaticResource DisplayModeToStretchConverter}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding BackgroundMedia, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible"/>
                                                        <Condition Binding="{Binding BackgroundMedia.Type, Converter={StaticResource MediaTypeIsVideoConverter}, ConverterParameter=Invert}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                
                                <!-- Background Media: Video -->
                                <MediaElement x:Name="BackgroundVideo"
                                              Source="{Binding BackgroundMedia.FilePath}"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Stop"
                                              Stretch="{Binding BackgroundMedia.DisplayMode, Converter={StaticResource DisplayModeToStretchConverter}}"
                                              IsMuted="True"
                                              MediaOpened="OnBackgroundVideoMediaOpened"
                                              MediaEnded="OnBackgroundVideoMediaEnded">
                                    <MediaElement.Style>
                                        <Style TargetType="MediaElement">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding BackgroundMedia, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible"/>
                                                        <Condition Binding="{Binding BackgroundMedia.Type, Converter={StaticResource MediaTypeIsVideoConverter}}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MediaElement.Style>
                                </MediaElement>
                                
                                <!-- Canvas for Regions -->
                                <Canvas x:Name="RegionCanvas"
                                        Width="1920"
                                        Height="1080"
                                        Background="Transparent"
                                        ClipToBounds="False"
                                        Cursor="{Binding IsAddingMode, Converter={StaticResource BooleanToCursorConverter}}"
                                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                        MouseMove="OnCanvasMouseMove"
                                        MouseLeftButtonUp="OnCanvasMouseLeftButtonUp">
                                    
                                    <ItemsControl ItemsSource="{Binding Regions}"
                                                  ItemTemplate="{StaticResource RegionItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas IsItemsHost="True" ClipToBounds="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource PercentageToPixelMultiConverter}">
                                                            <Binding Path="X"/>
                                                            <Binding Path="ActualWidth" ElementName="RegionCanvas"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Canvas.Top">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource PercentageToPixelMultiConverter}">
                                                            <Binding Path="Y"/>
                                                            <Binding Path="ActualHeight" ElementName="RegionCanvas"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Available Wallpaper Media -->
            <Border Grid.Column="1"
                    Background="{StaticResource BackgroundBlockBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0"
                               Text="Available Wallpapers"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="16,12"/>

                    <!-- Media List -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="8,0,8,8">
                        <ItemsControl ItemsSource="{Binding AvailableMedia}"
                                      ItemTemplate="{StaticResource MediaItemTemplate}"/>
                    </ScrollViewer>

                    <!-- Empty State (shown when no items) -->
                    <TextBlock Grid.Row="1"
                               Text="No wallpaper media available.&#x0a;Import media in Desktop Background first."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableMedia.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Section 4: Region Configuration Panel (visible when a region is selected) -->
        <StackPanel Grid.Row="3"
                    Margin="32,0,42,24"
                    Visibility="{Binding HasSelectedRegion, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Header with Import Buttons -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Configure Interaction"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ Image/Video"
                            Command="{Binding ImportRegionVisualCommand}"
                            Visibility="{Binding CanAddVisual, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource TextButtonStyle}"
                            Foreground="{StaticResource AccentBrush}"
                            Padding="8,4"
                            Margin="0,0,8,0"/>

                    <Button Content="+ Audio"
                            Command="{Binding ImportRegionAudioCommand}"
                            Visibility="{Binding CanAddAudio, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource TextButtonStyle}"
                            Foreground="{StaticResource AccentBrush}"
                            Padding="8,4"/>
                </StackPanel>
            </Grid>

            <!-- Image/Video Content Block -->
            <Border Background="{StaticResource BackgroundBlockBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12"
                    Visibility="{Binding SelectedRegion.VisualContent, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Image/Video"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <!-- Visual item displayed in rich format -->
                    <Grid MinHeight="80">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" Width="120" Height="68" CornerRadius="6" ClipToBounds="True"
                                Background="#FF121225" Margin="0,0,16,0">
                            <Grid>
                                <!-- Image Thumbnail (for image types) -->
                                <Image Source="{Binding SelectedRegion.VisualContent.ThumbnailPath}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding SelectedRegion.VisualContent.Type, Converter={StaticResource MediaTypeIsVideoConverter}, ConverterParameter=Invert}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRegion.VisualContent.ThumbnailPath}" Value="">
                                                    <Setter Property="Source" Value="{StaticResource DefaultThumbImage}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- Video Thumbnail (animated GIF or static fallback) -->
                                <Grid Visibility="{Binding SelectedRegion.VisualContent.Type, Converter={StaticResource MediaTypeIsVideoConverter}}">
                                    <MediaElement Source="{Binding SelectedRegion.VisualContent.ThumbnailPath}"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Stop"
                                                  Stretch="UniformToFill"
                                                  IsMuted="True"
                                                  MediaOpened="OnThumbnailMediaOpened"
                                                  MediaEnded="OnThumbnailMediaEnded"
                                                  Visibility="{Binding SelectedRegion.VisualContent.ThumbnailPath, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                    <Image Source="{StaticResource DefaultThumbImage}" 
                                           Stretch="Uniform"
                                           Visibility="{Binding SelectedRegion.VisualContent.ThumbnailPath, Converter={StaticResource InverseStringEmptyToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Preview Button Overlay -->
                                <Button Command="{Binding PreviewMediaCommand}"
                                        CommandParameter="{Binding SelectedRegion.VisualContent}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,4"
                                        Width="28" Height="28"
                                        Cursor="Hand"
                                        ToolTip="Preview">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#CC000000" CornerRadius="14"
                                                                Width="28" Height="28">
                                                            <Path Data="M8 5V19L19 12L8 5Z"
                                                                  Fill="White"
                                                                  Width="12" Height="12"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="2,0,0,0"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- File Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SelectedRegion.VisualContent.FileName}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontSize="13"
                                      TextTrimming="CharacterEllipsis"
                                      MaxWidth="200"
                                      HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedRegion.VisualContent.Format}"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="11"/>
                                <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedRegion.VisualContent.FileSize, Converter={StaticResource FileSizeConverter}}"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Controls -->
                        <StackPanel Grid.Column="2"
                                   Orientation="Horizontal"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right">

                            <!-- Mute Toggle (video only) -->
                            <Button Command="{Binding ToggleMuteCommand}"
                                    CommandParameter="{Binding SelectedRegion.VisualContent}"
                                    Visibility="{Binding SelectedRegion.VisualContent.Type, Converter={StaticResource MediaTypeIsVideoConverter}}"
                                    ToolTip="Toggle Mute"
                                    Cursor="Hand"
                                    Width="40" Height="40">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="20" Width="40" Height="40">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Path Data="M11 5L6 9H2V15H6L11 19V5ZM16 12C16 10.5 15.2 9.2 14 8.4V15.5C15.2 14.8 16 13.5 16 12Z"
                                          Fill="{StaticResource IconBrush}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          Visibility="{Binding SelectedRegion.VisualContent.IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Path Data="M3 9V15H7L12 20V4L7 9H3ZM16 12C16 13.66 15.17 15.13 13.93 16.02L15.35 17.44C17.22 16.05 18.5 13.77 18.5 11.99C18.5 10.21 17.22 7.94 15.35 6.55L13.93 7.97C15.17 8.85 16 10.33 16 12Z"
                                          Fill="{StaticResource AccentBrush}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          Visibility="{Binding SelectedRegion.VisualContent.IsMuted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>

                            <!-- Remove Button -->
                            <Button Command="{Binding RemoveRegionVisualCommand}"
                                    ToolTip="Remove"
                                    Cursor="Hand"
                                    Width="40" Height="40">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="20" Width="40" Height="40">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="M18 6L6 18M6 6L18 18"
                                      Stroke="{StaticResource IconBrush}"
                                      StrokeThickness="2"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio Content Block (separate from Image/Video) -->
            <Border Background="{StaticResource BackgroundBlockBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,24"
                    Visibility="{Binding SelectedRegion.AudioContent.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <StackPanel>
                    <!-- Header Row with Audio count and PlaybackMode dropdown -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedRegion.AudioContent.Count, StringFormat='Audio ({0})'}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- PlaybackMode ComboBox -->
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource RegionAudioPlaybackComboStyle}"
                                  Width="100"
                                  Margin="0,0,8,0"
                                  SelectedItem="{Binding SelectedRegion.AudioPlaybackMode}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="models:PlaybackMode">
                                    <models:PlaybackMode>Sequential</models:PlaybackMode>
                                    <models:PlaybackMode>Random</models:PlaybackMode>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <TextBlock Grid.Column="2"
                                   Text="max 5"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Audio Items List -->
                    <ListView Style="{StaticResource RegionMediaListViewStyle}"
                             ItemContainerStyle="{StaticResource RegionMediaListViewItemStyle}"
                             ItemTemplate="{StaticResource RegionAudioItemTemplate}"
                             ItemsSource="{Binding SelectedRegion.AudioContent}"
                             MaxHeight="250"
                             AllowDrop="True"
                             PreviewMouseMove="OnAudioListViewPreviewMouseMove"
                             PreviewMouseLeftButtonDown="OnAudioListViewPreviewMouseLeftButtonDown"
                             DragOver="OnAudioListViewDragOver"
                             Drop="OnAudioListViewDrop"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
